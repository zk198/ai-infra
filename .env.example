RAG_JWT_SECRET=replace-with-a-long-random-secret
RAG_DENSE_MODEL=BAAI/bge-small-en-v1.5
RAG_SPARSE_MODEL=Qdrant/bm25
RAG_QDRANT_COLLECTION=rag_chunks
RAG_DOWNSTREAM_TIMEOUT_SECONDS=60

# Host-published local endpoints (keep in sync with Compose port mappings)
AI_GATEWAY_PORT=8200
AI_UI_PORT=3000

# Optional URL overrides for local stack health checks.
# Host URLs default to the ports above; internal URLs default to Compose service ports.
AI_GATEWAY_HEALTH_URL=
AI_UI_URL=
QDRANT_HEALTH_URL=http://localhost:6333/healthz
AGENT_CORE_READY_URL=http://localhost:8000/api/v1/ready
AI_GATEWAY_READY_URL=http://localhost:8200/ready
LAYA_HEALTH_URL=http://localhost:8000/health
SGLANG_HEALTH_URL=http://localhost:30000/health
BIFROST_HEALTH_URL=http://localhost:8080/

# Optional Laya System-1 runtime (compose.laya.yaml)
LAYA_ENABLED=false
LAYA_TIMEOUT_SECONDS=5
LAYA_DEVICE=cpu
LAYA_PRELOAD=0
LAYA_MODELS=english,multilingual
LAYA_THREADS=4
LAYA_MAX_LOADED=2
LAYA_MAX_CONCURRENT=16
LAYA_MAX_TOKEN_BUDGET=8192
LAYA_LOG_LEVEL=info
LAYA_API_KEY=

# Local LLM stack (compose.llm.yaml)
BIFROST_ENCRYPTION_KEY=replace-with-a-random-encryption-key
SGLANG_API_KEY=local
HF_TOKEN=
MODEL_PATH=Qwen/Qwen3-4B-AWQ
MODEL_NAME=qwen3-4b
CONTEXT_LENGTH=16384
MEM_FRACTION_STATIC=0.85
MAX_RUNNING_REQUESTS=1
CHUNKED_PREFILL_SIZE=2048
